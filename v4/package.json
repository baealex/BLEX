{
  "name": "@blex/v4",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "postinstall": "prisma generate",
    "build": "tsc -p tsconfig.json && vite build",
    "dev": "npm run build && node dist/src/development.js",
    "type-check": "tsc -p tsconfig.json --noEmit",
    "db:check-legacy": "node dist/src/database-baseline.js",
    "db:migrate": "prisma migrate deploy",
    "start": "node dist/src/main.js",
    "test": "npm run build && node --test dist/test/*.test.js"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.5",
    "@fastify/formbody": "^9.0.2",
    "@fastify/multipart": "^9.4.0",
    "@fastify/static": "^10.1.12",
    "@prisma/client": "6.19.3",
    "fastify": "^5.12.7",
    "graphql": "^16.12.0",
    "htmlparser2": "^12.0.0",
    "mercurius": "^16.10.0",
    "otpauth": "^9.6.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router": "^7.18.6",
    "sanitize-html": "^2.17.0",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@fortawesome/fontawesome-free": "^7.3.0",
    "@tailwindcss/vite": "^4.3.2",
    "@tiptap/core": "^3.35.0",
    "@tiptap/extension-image": "^3.35.0",
    "@tiptap/extension-table": "^3.35.0",
    "@tiptap/pm": "^3.35.0",
    "@tiptap/react": "^3.35.0",
    "@tiptap/starter-kit": "^3.35.0",
    "@types/node": "^24.0.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/sanitize-html": "^2.16.0",
    "highlight.js": "^11.12.0",
    "prisma": "6.19.3",
    "sass": "^1.108.2",
    "tailwindcss": "^4.3.2",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^6.0.0",
    "vite": "^7.3.8"
  },
  "overrides": {
    "@prisma/config": {
      "deepmerge-ts": "8.0.0",
      "effect": "3.22.1"
    }
  }
}
