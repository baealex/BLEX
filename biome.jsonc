{
  "$schema": "https://biomejs.dev/schemas/2.6.8/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "packages/**/*.{ts,tsx,js,mjs}",
      ".github/scripts/*.mjs",
      "!**/routeTree.gen.ts",
      // Swagger UI's own bundle, served as published.
      "!packages/server/data/swagger-ui"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 120
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "a11y": {
        "noAutofocus": "error",
        "noLabelWithoutControl": "error",
        "noStaticElementInteractions": "error",
        "useAriaPropsSupportedByRole": "error",
        "useButtonType": "error",
        "useFocusableInteractive": "error",
        "useIframeTitle": "error",
        "useKeyWithClickEvents": "error",
        // Videos are uploaded without caption files, so there is no track to add.
        "useMediaCaption": "off",
        "useSemanticElements": "error"
      },
      "correctness": {
        "noComponentHookFactories": "error",
        "noVoidTypeReturn": "error",
        "useExhaustiveDependencies": {
          "level": "error",
          // Some effects list a value they never read so they re-run when it changes, such as to clear a selection.
          "options": { "reportUnnecessaryDependencies": false }
        },
        "useJsxKeyInIterable": "error"
      },
      "security": {
        "noDangerouslySetInnerHtml": "off"
      },
      "suspicious": {
        "noArrayIndexKey": "error",
        "noControlCharactersInRegex": "off",
        // The theme and Telegram hint cookies change synchronously; the Cookie Store API is async and not yet widely available.
        "noDocumentCookie": "off",
        "noImplicitAnyLet": "error",
        "noPrototypeBuiltins": "error",
        "noShadowRestrictedNames": "error",
        "noTemplateCurlyInString": "error",
        "useIterableCallbackReturn": "error"
      }
    }
  },
  "assist": {
    "enabled": false
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "jsxQuoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "all",
      "arrowParentheses": "always"
    }
  },
  "overrides": [
    {
      "includes": [".github/scripts/**"],
      "linter": {
        "rules": {
          "suspicious": {
            // These scripts read the GitHub Actions environment and never run as Turborepo tasks.
            "noUndeclaredEnvVars": "off"
          }
        }
      }
    },
    {
      "includes": ["packages/client/**", "packages/contracts/**"],
      "formatter": {
        "indentWidth": 4
      },
      "javascript": {
        "formatter": {
          "trailingCommas": "none"
        }
      },
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "~/ui": "Use component subpath imports (e.g. ~/ui/button).",
                  "~/features/editor/tiptap": "Use explicit subpath imports (e.g. ~/features/editor/tiptap/tiptap-editor)."
                }
              }
            }
          }
        }
      }
    },
    {
      "includes": [
        "packages/client/src/screen-runtime.tsx",
        "packages/client/src/components/screen-content.tsx",
        "packages/client/src/components/screen-props.ts"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "~/ui": "Use component subpath imports (e.g. ~/ui/button).",
                  "~/features/editor/tiptap": "Use explicit subpath imports only inside lazy-loaded feature modules.",
                  "@tanstack/react-router": "Bootstrap code must not statically import feature-heavy dependencies.",
                  "@tanstack/router-core": "Bootstrap code must not statically import feature-heavy dependencies.",
                  "@monaco-editor/react": "Bootstrap code must not statically import feature-heavy dependencies.",
                  "frappe-charts": "Bootstrap code must not statically import feature-heavy dependencies.",
                  "zod": "Bootstrap code must not statically import feature-heavy dependencies."
                },
                "patterns": [
                  {
                    "group": ["~/features/editor/tiptap/*", "@tiptap/*", "prosemirror*", "zod/*"],
                    "message": "Bootstrap code must not statically import feature-heavy dependencies."
                  }
                ]
              }
            }
          }
        }
      }
    }
  ]
}
