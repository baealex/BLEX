   "html": "<p>&lt;caption&gt;x</p>"
  },
  {
   "name": "gif-http",
   "markdown": "@gif[http://a.example/a.mp4]",
   "html": "<p><video autoplay=\"\" class=\"lazy\" loop=\"\" muted=\"\" playsinline=\"\" poster=\"http://a.example/a.mp4.preview.jpg\"><source data-src=\"http://a.example/a.mp4\" type=\"video/mp4\"/></video></p>"
  },
  {
   "name": "gif-query",
   "markdown": "@gif[https://a.example/a.mp4?x=1]",
   "html": "<p><video autoplay=\"\" class=\"lazy\" loop=\"\" muted=\"\" playsinline=\"\" poster=\"https://a.example/a.mp4?x=1.preview.jpg\"><source data-src=\"https://a.example/a.mp4?x=1\" type=\"video/mp4\"/></video></p>"
  },
  {
   "name": "gif-amp",
   "markdown": "@gif[https://a.example/a.mp4?x=1&y=2]",
   "html": "<p><video autoplay=\"\" class=\"lazy\" loop=\"\" muted=\"\" playsinline=\"\" poster=\"https://a.example/a.mp4?x=1&amp;amp;y=2.preview.jpg\"><source data-src=\"https://a.example/a.mp4?x=1&amp;amp;y=2\" type=\"video/mp4\"/></video></p>"
  },
