  },
  {
   "name": "gif-under",
   "markdown": "@gif[https://a.example/a_b_c.mp4]",
   "html": "<p><video autoplay=\"\" class=\"lazy\" loop=\"\" muted=\"\" playsinline=\"\" poster=\"https://a.example/a_b_c.mp4.preview.jpg\"><source data-src=\"https://a.example/a_b_c.mp4\" type=\"video/mp4\"/></video></p>"
  },
  {
   "name": "gif-upper",
   "markdown": "@gif[https://a.example/A.MP4]",
