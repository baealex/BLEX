  },
  {
   "name": "yt-under",
   "markdown": "@youtube[a_b_c]",
   "html": "<p><figure style=\"text-align: center; display: flex; justify-content: center; flex-direction: column; align-items: center\"><iframe allow=\"accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture\" allowfullscreen=\"\" data-aspect-ratio=\"16:9\" frameborder=\"0\" src=\"https://www.youtube.com/embed/a_b_c\" style=\"width: 100%; aspect-ratio: 16 / 9; border: 0\"></iframe></figure></p>"
  },
  {
   "name": "yt-dash",
   "markdown": "@youtube[a-b]",
   "html": "<p><figure style=\"text-align: center; display: flex; justify-content: center; flex-direction: column; align-items: center\"><iframe allow=\"accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture\" allowfullscreen=\"\" data-aspect-ratio=\"16:9\" frameborder=\"0\" src=\"https://www.youtube.com/embed/a-b\" style=\"width: 100%; aspect-ratio: 16 / 9; border: 0\"></iframe></figure></p>"
  },
  {
   "name": "yt-ratio-one",
   "markdown": "@youtube[abc]{16}",
   "html": "<p><figure style=\"text-align: center; display: flex; justify-content: center; flex-direction: column; align-items: center\"><iframe allow=\"accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture\" allowfullscreen=\"\" data-aspect-ratio=\"16\" frameborder=\"0\" src=\"https://www.youtube.com/embed/abc\" style=\"width: 100%; aspect-ratio: 16; border: 0\"></iframe></figure></p>"
  },
  {
   "name": "yt-ratio-bad",
   "markdown": "@youtube[abc]{a:b}",
   "html": "<p>@youtube[abc]{a:b}</p>"
  },
  {
   "name": "yt-empty-ratio",
   "markdown": "@youtube[abc]{}",
   "html": "<p><figure style=\"text-align: center; display: flex; justify-content: center; flex-direction: column; align-items: center\"><iframe allow=\"accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture\" allowfullscreen=\"\" data-aspect-ratio=\"16:9\" frameborder=\"0\" src=\"https://www.youtube.com/embed/abc\" style=\"width: 100%; aspect-ratio: 16 / 9; border: 0\"></iframe></figure>{}</p>"
  },
  {
   "name": "yt-twice",
   "markdown": "@youtube[a] @youtube[b]",
   "html": "<p><figure style=\"text-align: center; display: flex; justify-content: center; flex-direction: column; align-items: center\"><iframe allow=\"accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture\" allowfullscreen=\"\" data-aspect-ratio=\"16:9\" frameborder=\"0\" src=\"https://www.youtube.com/embed/a\" style=\"width: 100%; aspect-ratio: 16 / 9; border: 0\"></iframe></figure> <figure style=\"text-align: center; display: flex; justify-content: center; flex-direction: column; align-items: center\"><iframe allow=\"accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture\" allowfullscreen=\"\" data-aspect-ratio=\"16:9\" frameborder=\"0\" src=\"https://www.youtube.com/embed/b\" style=\"width: 100%; aspect-ratio: 16 / 9; border: 0\"></iframe></figure></p>"
  },
  {
   "name": "yt-in-list",
   "markdown": "- @youtube[abc]",
   "html": "<ul>\n<li><figure style=\"text-align: center; display: flex; justify-content: center; flex-direction: column; align-items: center\"><iframe allow=\"accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture\" allowfullscreen=\"\" data-aspect-ratio=\"16:9\" frameborder=\"0\" src=\"https://www.youtube.com/embed/abc\" style=\"width: 100%; aspect-ratio: 16 / 9; border: 0\"></iframe></figure></li>\n</ul>"
  },
  {
   "name": "yt-in-quote",
   "markdown": "> @youtube[abc]",
   "html": "<blockquote>\n<p><figure style=\"text-align: center; display: flex; justify-content: center; flex-direction: column; align-items: center\"><iframe allow=\"accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture\" allowfullscreen=\"\" data-aspect-ratio=\"16:9\" frameborder=\"0\" src=\"https://www.youtube.com/embed/abc\" style=\"width: 100%; aspect-ratio: 16 / 9; border: 0\"></iframe></figure></p>\n</blockquote>"
  },
  {
   "name": "task-upper",
   "markdown": "- [X] a",
   "html": "<ul class=\"task-list\">\n<li class=\"task-list-item\"> a</li>\n</ul>"
  },
  {
   "name": "task-loose",
   "markdown": "- [ ] a\n\n- [x] b",
   "html": "<ul class=\"task-list\">\n<li class=\"task-list-item\">\n<p> a</p>\n</li>\n<li class=\"task-list-item\">\n<p> b</p>\n</li>\n</ul>"
  },
  {
   "name": "task-ol",
   "markdown": "1. [ ] a",
   "html": "<ol class=\"task-list\">\n<li class=\"task-list-item\"> a</li>\n</ol>"
  },
  {
   "name": "task-nested",
   "markdown": "- [ ] a\n    - [x] b",
   "html": "<ul class=\"task-list\">\n<li class=\"task-list-item\"> a<ul class=\"task-list\">\n<li class=\"task-list-item\"> b</li>\n</ul>\n</li>\n</ul>"
  },
  {
   "name": "task-nospace",
   "markdown": "- [x]a",
   "html": "<ul>\n<li>[x]a</li>\n</ul>"
  },
  {
   "name": "task-empty",
   "markdown": "- [ ] ",
   "html": "<ul class=\"task-list\">\n<li class=\"task-list-item\"> </li>\n</ul>"
  },
  {
   "name": "mark-space",
   "markdown": "== a ==",
   "html": "<p>== a ==</p>"
  },
  {
   "name": "mark-multi",
   "markdown": "==a== ==b==",
   "html": "<p><mark>a</mark> <mark>b</mark></p>"
  },
  {
   "name": "sub-space",
   "markdown": "a~b c~d",
   "html": "<p>a~b c~d</p>"
  },
  {
   "name": "sup",
   "markdown": "a^2^",
   "html": "<p>a^2^</p>"
  },
  {
   "name": "del-sub",
   "markdown": "~~a~b~c~~",
   "html": "<p><del>a<sub>b</sub>c</del></p>"
  },
  {
   "name": "fn-repeat",
   "markdown": "a[^1] b[^1]\n\n[^1]: n",
   "html": "<p>a<sup><a class=\"footnote-ref\" href=\"#fn:1\">1</a></sup> b<sup><a class=\"footnote-ref\" href=\"#fn:1\">1</a></sup></p>\n<div class=\"footnote\">\n<hr/>\n<ol>\n<li>\n<p>n <a class=\"footnote-backref\" href=\"#fnref:1\" title=\"Jump back to footnote 1 in the text\">↩</a><a class=\"footnote-backref\" href=\"#fnref2:1\" title=\"Jump back to footnote 1 in the text\">↩</a></p>\n</li>\n</ol>\n</div>"
  },
  {
   "name": "fn-order",
   "markdown": "a[^b] c[^a]\n\n[^a]: first\n[^b]: second",
   "html": "<p>a<sup><a class=\"footnote-ref\" href=\"#fn:b\">2</a></sup> c<sup><a class=\"footnote-ref\" href=\"#fn:a\">1</a></sup></p>\n<div class=\"footnote\">\n<hr/>\n<ol>\n<li>\n<p>first <a class=\"footnote-backref\" href=\"#fnref:a\" title=\"Jump back to footnote 1 in the text\">↩</a></p>\n</li>\n<li>\n<p>second <a class=\"footnote-backref\" href=\"#fnref:b\" title=\"Jump back to footnote 2 in the text\">↩</a></p>\n</li>\n</ol>\n</div>"
  },
  {
   "name": "fn-missing",
   "markdown": "a[^x]",
   "html": "<p>a[^x]</p>"
  },
  {
   "name": "fn-multi",
   "markdown": "a[^1]\n\n[^1]: p1\n\n    p2",
   "html": "<p>a<sup><a class=\"footnote-ref\" href=\"#fn:1\">1</a></sup></p>\n<div class=\"footnote\">\n<hr/>\n<ol>\n<li>\n<p>p1</p>\n<p>p2 <a class=\"footnote-backref\" href=\"#fnref:1\" title=\"Jump back to footnote 1 in the text\">↩</a></p>\n</li>\n</ol>\n</div>"
  },
  {
   "name": "fn-unused",
   "markdown": "a\n\n[^1]: n",
   "html": "<p>a</p>\n<div class=\"footnote\">\n<hr/>\n<ol>\n<li>\n<p>n <a class=\"footnote-backref\" href=\"#fnref:1\" title=\"Jump back to footnote 1 in the text\">↩</a></p>\n</li>\n</ol>\n</div>"
  },
  {
   "name": "def-multi",
   "markdown": "t1\n: d1\n\nt2\n: d2",
   "html": "\nt1\nd1\nt2\nd2\n"
