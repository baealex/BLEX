  {
   "name": "spec-style-escaped",
   "markdown": "<style>\nbody { color: red; }\n</style>\n\nText",
   "html": "<p>&lt;style&gt;<br/>\nbody { color: red; }<br/>\n&lt;/style&gt;</p>\n<p>Text</p>"
  },
  {
   "name": "spec-script-escaped",
   "markdown": "Before\n\n<script>alert(1)</script>\n\nAfter",
   "html": "<p>Before</p>\n<p>&lt;script&gt;alert(1)&lt;/script&gt;</p>\n<p>After</p>"
  },
  {
   "name": "spec-div-escaped",
   "markdown": "<div class=\"x\">content</div>\n",
   "html": "<p>&lt;div class=\"x\"&gt;content&lt;/div&gt;</p>"
  },
  {
   "name": "spec-style-in-fence",
   "markdown": "```html\n<style>a { color: red; }</style>\n```\n",
   "html": "<div class=\"highlight\"><pre><span></span><code><span class=\"p\">&lt;</span><span class=\"nt\">style</span><span class=\"p\">&gt;</span><span class=\"nt\">a</span><span class=\"w\"> </span><span class=\"p\">{</span><span class=\"w\"> </span><span class=\"k\">color</span><span class=\"p\">:</span><span class=\"w\"> </span><span class=\"kc\">red</span><span class=\"p\">;</span><span class=\"w\"> </span><span class=\"p\">}&lt;/</span><span class=\"nt\">style</span><span class=\"p\">&gt;</span>\n</code></pre></div>"
  },
  {
   "name": "spec-style-in-tilde-fence",
   "markdown": "~~~html\n<style>a { color: red; }</style>\n~~~\n",
   "html": "<div class=\"highlight\"><pre><span></span><code><span class=\"p\">&lt;</span><span class=\"nt\">style</span><span class=\"p\">&gt;</span><span class=\"nt\">a</span><span class=\"w\"> </span><span class=\"p\">{</span><span class=\"w\"> </span><span class=\"k\">color</span><span class=\"p\">:</span><span class=\"w\"> </span><span class=\"kc\">red</span><span class=\"p\">;</span><span class=\"w\"> </span><span class=\"p\">}&lt;/</span><span class=\"nt\">style</span><span class=\"p\">&gt;</span>\n</code></pre></div>"
  },
  {
   "name": "spec-inline-code",
   "markdown": "Use `<style>` to add CSS.\n",
   "html": "<p>Use <code>&lt;style&gt;</code> to add CSS.</p>"
