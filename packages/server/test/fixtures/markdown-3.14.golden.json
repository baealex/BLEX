   "html": "<table>\n<thead>\n<tr>\n<th>a</th>\n<th>b</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>1</td>\n<td>2</td>\n</tr>\n</tbody>\n</table>"
  },
  {
   "name": "table-inline",
   "markdown": "| a |\n|---|\n| **b** `c` |",
   "html": "<table>\n<thead>\n<tr>\n<th>a</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td><strong>b</strong> <code>c</code></td>\n</tr>\n</tbody>\n</table>"
  },
  {
   "name": "table-pipe-code",
   "markdown": "| a |\n|---|\n| `b\\|c` |",
   "html": "<table>\n<thead>\n<tr>\n<th>a</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td><code>b\\|c</code></td>\n</tr>\n</tbody>\n</table>"
  },
  {
   "name": "table-short",
   "markdown": "| a | b |\n|---|---|\n| 1 |",
   "html": "<table>\n<thead>\n<tr>\n<th>a</th>\n<th>b</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>1</td>\n<td></td>\n</tr>\n</tbody>\n</table>"
  },
  {
   "name": "table-long",
   "markdown": "| a |\n|---|\n| 1 | 2 |",
   "html": "<table>\n<thead>\n<tr>\n<th>a</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>1</td>\n</tr>\n</tbody>\n</table>"
  },
  {
   "name": "table-after-para",
   "markdown": "text\n| a |\n|---|\n| 1 |",
   "html": "<p>text<br/>\n| a |<br/>\n|---|<br/>\n| 1 |</p>"
