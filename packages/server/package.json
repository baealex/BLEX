{
  "name": "@blex/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^24.22.1 || >=26.12.1"
  },
  "scripts": {
    "postinstall": "prisma generate",
    "build": "tsc -p tsconfig.json",
    "dev": "pnpm run build && node dist/src/development.js",
    "type-check": "tsc -p tsconfig.json --noEmit",
    "i18n:check": "pnpm run build && node --test dist/test/message-catalog.test.js",
    "db:migrate": "prisma migrate deploy",
    "start": "node dist/src/main.js",
    "test": "pnpm run build && TZ=Asia/Seoul node --test dist/test/*.test.js"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.5",
    "@fastify/formbody": "^9.0.2",
    "@fastify/multipart": "^9.4.0",
    "@fastify/static": "^10.1.12",
    "@fastify/swagger": "9.9.5",
    "@prisma/client": "6.19.3",
    "ajv": "8.20.0",
    "fastify": "^5.12.7",
    "htmlparser2": "^12.0.0",
    "markdown-it": "15.0.3",
    "markdown-it-cjk-friendly": "3.0.0",
    "markdown-it-deflist": "4.0.0",
    "markdown-it-footnote": "4.0.0",
    "markdown-it-mark": "4.0.0",
    "markdown-it-sub": "2.0.0",
    "otpauth": "^9.6.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sanitize-html": "^2.17.0",
    "sharp": "^0.35.5",
    "typebox": "1.4.7"
  },
  "devDependencies": {
    "@blex/contracts": "workspace:*",
    "@types/node": "^24.0.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/sanitize-html": "^2.16.0",
    "@vercel/nft": "^1.11.11",
    "prisma": "6.19.3",
    "typescript": "^6.0.0"
  }
}
