generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum UserRole {
  READER
  EDITOR
}

enum ContentScope {
  user
  global
}

enum SubscriptionAction {
  subscribe
  unsubscribe
}

enum CoverLayout {
  default
  split
  overlay
  none
}

enum CoverImagePosition {
  right
  left
}

enum RevisionType {
  edit
  restore
  legacy
  draft
}

enum BannerType {
  horizontal
  sidebar
}

enum BannerPosition {
  top
  bottom
  left
  right
}

// Accounts

model User {
  id                    Int       @id @default(autoincrement())
  username              String    @unique
  email                 String
  passwordHash          String
  name                  String    @default("")
  isActive              Boolean   @default(true)
  isStaff               Boolean   @default(false)
  isSuperuser           Boolean   @default(false)
  canManageSiteSettings Boolean   @default(false)
  lastLoginAt           DateTime?
  joinedAt              DateTime  @default(now())

  profile              Profile?
  preference           UserPreference?
  twoFactor            TwoFactorAuth?
  telegram             TelegramConnection?
  socialLinks          SocialLink[]
  socialAccounts       SocialAccount[]
  usernameChanges      UsernameChange[]
  sessions             Session[]
  createdInvites       AuthorInvite[]          @relation("InviteCreator")
  claimedInvites       AuthorInvite[]          @relation("InviteClaimer")
  subscriptions        AuthorSubscription[]    @relation("Subscriber")
  subscribers          AuthorSubscription[]    @relation("SubscribedAuthor")
  subscriptionLogs     AuthorSubscriptionLog[] @relation("LogSubscriber")
  subscriberLogs       AuthorSubscriptionLog[] @relation("LogAuthor")
  posts                Post[]
  postRevisions        PostRevision[]
  postLikes            PostLike[]
  pinnedPosts          PinnedPost[]
  series               Series[]
  comments             Comment[]
  commentLikes         CommentLike[]
  formTemplates        FormTemplate[]
  uploadedImages       UploadedImage[]
  staticPages          StaticPage[]
  notices              SiteNotice[]
  banners              SiteBanner[]
  adminLogs            AdminLog[]
  notifications        Notification[]
  webhookChannels      WebhookChannel[]
  developerTokens      DeveloperToken[]
  developerRequests    DeveloperRequestLog[]
  workLogs             WorkLog[]
  cleanupConfirmations CleanupConfirmation[]
}

model Profile {
  userId        Int      @id
  role          UserRole @default(READER)
  bio           String   @default("")
  avatar        String   @default("")
  cover         String   @default("")
  homepage      String   @default("")
  aboutMarkdown String   @default("")
  aboutHtml     String   @default("")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserPreference {
  userId            Int      @id
  language          String?
  timeZone          String   @default("")
  notifyPostLike    Boolean?
  notifyPostComment Boolean?
  notifyCommentLike Boolean?
  notifyMention     Boolean?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model SocialLink {
  id        Int      @id @default(autoincrement())
  userId    Int
  platform  String
  url       String
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, order])
}

model SocialProvider {
  id           Int     @id @default(autoincrement())
  key          String  @unique
  clientId     String  @default("")
  clientSecret String  @default("")
  isEnabled    Boolean @default(false)

  accounts SocialAccount[]
}

model SocialAccount {
  id         Int      @id @default(autoincrement())
  providerId Int
  uid        String
  userId     Int
  extraData  String   @default("")
  createdAt  DateTime @default(now())

  provider   SocialProvider   @relation(fields: [providerId], references: [id], onDelete: Cascade)
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  challenges OAuthChallenge[]

  @@unique([providerId, uid])
  @@index([userId])
}

model TwoFactorAuth {
  id          Int      @id @default(autoincrement())
  userId      Int      @unique
  totpSecret  String
  recoveryKey String
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model TelegramConnection {
  userId             Int       @id
  telegramId         String    @default("")
  authToken          String    @default("")
  authTokenExpiresAt DateTime?
  createdAt          DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UsernameChange {
  id        Int      @id @default(autoincrement())
  userId    Int
  username  String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([username])
  @@index([userId])
}

model AuthorInvite {
  id          Int       @id @default(autoincrement())
  code        String    @unique
  note        String    @default("")
  isActive    Boolean   @default(true)
  createdById Int?
  claimedById Int?
  createdAt   DateTime  @default(now())
  claimedAt   DateTime?

  createdBy User? @relation("InviteCreator", fields: [createdById], references: [id], onDelete: SetNull)
  claimedBy User? @relation("InviteClaimer", fields: [claimedById], references: [id], onDelete: SetNull)

  @@index([createdById])
  @@index([claimedById])
}

model LoginAttempt {
  key    String @id
  window BigInt
  count  Int

  @@index([window])
}

model Session {
  tokenHash        String    @id
  userId           Int
  credentialTag    String
  expiresAt        DateTime
  verifiedUntil    DateTime?
  verifiedFactorId Int?
  requiresFactor   Boolean   @default(false)

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  factorSetup FactorSetup?

  @@index([userId])
  @@index([expiresAt])
}

model FactorSetup {
  sessionHash  String   @id
  secret       String
  recoveryHash String
  expiresAt    DateTime

  session Session @relation(fields: [sessionHash], references: [tokenHash], onDelete: Cascade, onUpdate: Cascade)
}

model OAuthFlow {
  stateHash   String   @id
  browserHash String
  provider    String
  verifier    String
  returnPath  String
  sessionHash String?
  language    String   @default("")
  timeZone    String   @default("")
  expiresAt   DateTime

  @@index([expiresAt])
}

model OAuthChallenge {
  tokenHash       String   @id
  socialAccountId Int
  returnPath      String
  expiresAt       DateTime

  socialAccount SocialAccount @relation(fields: [socialAccountId], references: [id], onDelete: Cascade)

  @@index([socialAccountId])
  @@index([expiresAt])
}

model AuthorSubscription {
  id           Int      @id @default(autoincrement())
  subscriberId Int
  authorId     Int
  createdAt    DateTime @default(now())

  subscriber User @relation("Subscriber", fields: [subscriberId], references: [id], onDelete: Cascade)
  author     User @relation("SubscribedAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  @@unique([subscriberId, authorId])
  @@index([authorId, createdAt])
}

model AuthorSubscriptionLog {
  id           Int                @id @default(autoincrement())
  subscriberId Int
  authorId     Int
  action       SubscriptionAction
  createdAt    DateTime           @default(now())

  subscriber User @relation("LogSubscriber", fields: [subscriberId], references: [id], onDelete: Cascade)
  author     User @relation("LogAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  @@index([authorId, createdAt])
  @@index([subscriberId])
}

// Posts

model Post {
  id                 Int                @id @default(autoincrement())
  authorId           Int
  seriesId           Int?
  slug               String             @unique
  title              String
  subtitle           String             @default("")
  description        String             @default("")
  image              String             @default("")
  imageHash          String             @default("")
  readTime           Int                @default(1)
  isHidden           Boolean            @default(false)
  isAdvertised       Boolean            @default(false)
  commentsBlocked    Boolean            @default(false)
  coverLayout        CoverLayout        @default(default)
  coverImagePosition CoverImagePosition @default(right)
  /// One of auto, 16:9, 4:3, 1:1, or 3:4.
  coverImageRatio    String             @default("auto")
  createdAt          DateTime           @default(now())
  /// Set by the editor. Hiding, pinning, or moving a post must not change it.
  updatedAt          DateTime           @default(now())
  publishedAt        DateTime?
  deletedAt          DateTime?
  draftScheduledAt   DateTime?

  author               User                  @relation(fields: [authorId], references: [id], onDelete: Cascade)
  series               Series?               @relation(fields: [seriesId], references: [id], onDelete: SetNull)
  content              PostContent?
  tags                 Tag[]
  comments             Comment[]
  revisions            PostRevision[]
  likes                PostLike[]
  pins                 PinnedPost[]
  shareLinks           PostShareLink[]
  scheduledPublication ScheduledPublication?
  webhookDeliveries    WebhookDelivery[]

  @@index([authorId, publishedAt])
  @@index([authorId, createdAt])
  @@index([publishedAt])
  @@index([createdAt])
  @@index([deletedAt])
  @@index([seriesId])
  @@index([imageHash])
}

model PostContent {
  postId Int    @id
  html   String

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
}

model Tag {
  id    Int    @id @default(autoincrement())
  name  String @unique
  posts Post[]
}

model PostRevision {
  id              Int          @id @default(autoincrement())
  postId          Int
  actorId         Int?
  restoredFromId  Int?
  type            RevisionType
  title           String       @default("")
  subtitle        String       @default("")
  description     String       @default("")
  content         String       @default("")
  contentExcerpt  String?
  tags            Json
  sourceUpdatedAt DateTime?
  createdAt       DateTime     @default(now())

  post         Post           @relation(fields: [postId], references: [id], onDelete: Cascade)
  actor        User?          @relation(fields: [actorId], references: [id], onDelete: SetNull)
  restoredFrom PostRevision?  @relation("RevisionRestore", fields: [restoredFromId], references: [id], onDelete: SetNull)
  restores     PostRevision[] @relation("RevisionRestore")

  @@index([postId, createdAt])
  @@index([restoredFromId])
  @@index([actorId])
}

model PostLike {
  postId    Int
  userId    Int
  createdAt DateTime @default(now())

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([postId, userId])
  @@index([userId, createdAt])
}

model PinnedPost {
  userId    Int
  postId    Int
  order     Int      @default(0)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@id([userId, postId])
  @@index([postId])
}

model PostShareLink {
  id        Int      @id @default(autoincrement())
  postId    Int
  token     String   @unique
  label     String   @default("")
  isPaused  Boolean  @default(false)
  createdAt DateTime @default(now())

  post        Post                  @relation(fields: [postId], references: [id], onDelete: Cascade)
  dailyCounts PostShareDailyCount[]

  @@index([postId])
}

model PostShareDailyCount {
  linkId Int
  day    DateTime
  clicks Int      @default(0)

  link PostShareLink @relation(fields: [linkId], references: [id], onDelete: Cascade)

  @@id([linkId, day])
}

model ScheduledPublication {
  postId    Int      @id
  publishAt DateTime

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([publishAt])
}

model Series {
  id                    Int      @id @default(autoincrement())
  ownerId               Int
  slug                  String   @unique
  name                  String
  descriptionMarkdown   String   @default("")
  descriptionHtml       String   @default("")
  isHidden              Boolean  @default(false)
  layout                String   @default("")
  order                 Int      @default(0)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @default(now())
  /// Microseconds past createdAt's millisecond. 3.x dates had them and the Developer API still returns them.
  createdAtMicroseconds Int      @default(0)
  /// Microseconds past updatedAt's millisecond. Reset to 0 whenever updatedAt is written.
  updatedAtMicroseconds Int      @default(0)

  owner User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  posts Post[]

  @@index([ownerId])
}

model Comment {
  id        Int      @id @default(autoincrement())
  postId    Int
  authorId  Int?
  parentId  Int?
  markdown  String   @default("")
  html      String   @default("")
  isEdited  Boolean  @default(false)
  isHearted Boolean  @default(false)
  createdAt DateTime @default(now())

  post    Post          @relation(fields: [postId], references: [id], onDelete: Cascade)
  author  User?         @relation(fields: [authorId], references: [id], onDelete: SetNull)
  parent  Comment?      @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies Comment[]     @relation("CommentReplies")
  likes   CommentLike[]

  @@index([authorId, createdAt])
  @@index([postId, parentId, createdAt])
  @@index([parentId])
}

model CommentLike {
  commentId Int
  userId    Int

  comment Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([commentId, userId])
  @@index([userId])
}

model FormTemplate {
  id        Int      @id @default(autoincrement())
  userId    Int
  title     String
  content   String   @default("")
  isPublic  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model UploadedImage {
  id     Int    @id @default(autoincrement())
  key    String @unique
  path   String @unique
  size   Int
  userId Int?

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
}

// Site

model SiteSetting {
  id                  Int      @id @default(1)
  siteName            String   @default("BLEX")
  /// Host used for RSS links when it differs from SITE_URL.
  domain              String   @default("")
  headerScript        String   @default("")
  footerScript        String   @default("")
  seoEnabled          Boolean  @default(true)
  aeoEnabled          Boolean  @default(false)
  robotsTxtExtraRules String   @default("")
  logoSvg             String   @default("")
  logoSvgDark         String   @default("")
  iconSvg             String   @default("")
  iconSvgDark         String   @default("")
  iconManifest        Json?
  updatedAt           DateTime @updatedAt
}

model LoginSetting {
  id                         Int      @id @default(1)
  welcomeNotificationMessage String   @default("")
  welcomeNotificationUrl     String   @default("/")
  accountDeletionRedirectUrl String   @default("")
  hcaptchaEnabled            Boolean  @default(false)
  hcaptchaSiteKey            String   @default("")
  hcaptchaSecretKey          String   @default("")
  updatedAt                  DateTime @updatedAt
}

model IntegrationSetting {
  id                  Int      @id @default(1)
  telegramEnabled     Boolean  @default(false)
  telegramBotUsername String   @default("")
  telegramBotToken    String   @default("")
  updatedAt           DateTime @updatedAt
}

model StaticPage {
  id           Int      @id @default(autoincrement())
  authorId     Int?
  slug         String   @unique
  title        String
  content      String   @default("")
  description  String   @default("")
  isPublished  Boolean  @default(false)
  showInFooter Boolean  @default(false)
  order        Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  author User? @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([authorId])
}

model SiteNotice {
  id        Int          @id @default(autoincrement())
  userId    Int?
  scope     ContentScope
  title     String
  url       String       @default("")
  isActive  Boolean      @default(true)
  order     Int          @default(0)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isActive])
  @@index([scope, isActive])
}

model SiteBanner {
  id          Int            @id @default(autoincrement())
  userId      Int?
  scope       ContentScope
  type        BannerType
  position    BannerPosition
  title       String         @default("")
  contentHtml String         @default("")
  isActive    Boolean        @default(true)
  order       Int            @default(0)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isActive])
  @@index([scope, isActive, type, position])
}

model AdminLog {
  id         Int      @id @default(autoincrement())
  userId     Int
  target     String   @default("")
  objectId   String?
  objectName String   @default("")
  action     Int
  message    String   @default("")
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
}

model CleanupConfirmation {
  id                 Int       @id @default(autoincrement())
  userId             Int
  tokenHash          String    @unique
  action             String
  sessionFingerprint String
  expiresAt          DateTime
  consumedAt         DateTime?
  createdAt          DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@index([userId])
}

// Notifications and integrations

model Notification {
  id            Int      @id @default(autoincrement())
  userId        Int
  key           String   @unique
  url           String   @default("")
  content       String   @default("")
  messageKey    String   @default("")
  messageParams Json
  isRead        Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @default(now())

  user     User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  delivery NotificationDelivery?

  @@index([userId])
}

model NotificationDelivery {
  notificationId Int      @id
  attempts       Int      @default(0)
  availableAt    DateTime

  notification Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  @@index([availableAt])
}

model WebhookChannel {
  id            Int          @id @default(autoincrement())
  ownerId       Int?
  scope         ContentScope
  name          String       @default("")
  url           String
  isActive      Boolean      @default(true)
  failureCount  Int          @default(0)
  lastSuccessAt DateTime?
  createdAt     DateTime     @default(now())

  owner      User?             @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  deliveries WebhookDelivery[]

  @@unique([scope, ownerId, url])
  @@index([ownerId])
}

model WebhookDelivery {
  postId      Int
  channelId   Int
  availableAt DateTime
  isDone      Boolean  @default(false)

  post    Post           @relation(fields: [postId], references: [id], onDelete: Cascade)
  channel WebhookChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@id([postId, channelId])
  @@index([isDone, availableAt])
}

model DeveloperToken {
  id          Int       @id @default(autoincrement())
  userId      Int
  name        String
  tokenPrefix String    @unique
  tokenHash   String    @unique
  scopes      Json
  expiresAt   DateTime?
  revokedAt   DateTime?
  lastUsedAt  DateTime?
  lastUsedIp  String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user     User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  requests DeveloperRequestLog[]

  @@index([userId, revokedAt])
}

model DeveloperRequestLog {
  id         Int      @id @default(autoincrement())
  userId     Int
  tokenId    Int?
  method     String
  path       String
  statusCode Int
  ipAddress  String?
  userAgent  String   @default("")
  createdAt  DateTime @default(now())

  user  User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  token DeveloperToken? @relation(fields: [tokenId], references: [id], onDelete: SetNull)

  @@index([tokenId, createdAt])
  @@index([userId, createdAt])
}

// Work logs

model WorkLog {
  id        Int      @id @default(autoincrement())
  ownerId   Int
  title     String
  createdAt DateTime @default(now())

  owner   User           @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  entries WorkLogEntry[]
  shares  WorkLogShare[]

  @@index([ownerId])
}

model WorkLogEntry {
  id         Int      @id @default(autoincrement())
  logId      Int
  title      String   @default("")
  text       String   @default("")
  mediaType  String   @default("")
  attachment String   @default("")
  createdAt  DateTime @default(now())

  log    WorkLog        @relation(fields: [logId], references: [id], onDelete: Cascade)
  shares WorkLogShare[]

  @@index([logId, createdAt(sort: Desc), id(sort: Desc)])
}

model WorkLogShare {
  id        Int      @id @default(autoincrement())
  logId     Int
  token     String   @unique
  headline  String   @default("")
  createdAt DateTime @default(now())

  log     WorkLog        @relation(fields: [logId], references: [id], onDelete: Cascade)
  entries WorkLogEntry[]

  @@index([logId])
}
