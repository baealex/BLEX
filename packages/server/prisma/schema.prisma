generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum ContentScope {
  user
  global
}

enum BannerType {
  horizontal
  sidebar
}

enum BannerPosition {
  top
  bottom
  left
  right
}

model OAuthFlow {
  stateHash   String  @id @map("state_hash")
  browserHash String  @map("browser_hash")
  provider    String
  verifier    String
  returnPath  String  @map("return_path")
  expiresAt   BigInt  @map("expires_at")
  sessionHash String? @map("session_hash")
  language    String  @default("")
  timeZone    String  @default("") @map("time_zone")

  @@index([expiresAt], map: "blex_oauth_flow_expires_at_idx")
  @@map("blex_oauth_flow")
}

model OAuthChallenge {
  tokenHash    String           @id @map("token_hash")
  socialAuthId Int              @map("social_auth_id")
  returnPath   String           @map("return_path")
  expiresAt    BigInt           @map("expires_at")
  socialAuth   board_socialauth @relation(fields: [socialAuthId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([socialAuthId], map: "blex_oauth_challenge_social_auth_id_idx")
  @@index([expiresAt], map: "blex_oauth_challenge_expires_at_idx")
  @@map("blex_oauth_challenge")
}

/// Existing Django account table and relationships.
model User {
  id                                                                               Int                           @id @default(autoincrement())
  password                                                                         String
  last_login                                                                       DateTime?
  is_superuser                                                                     Boolean
  username                                                                         String                        @unique
  last_name                                                                        String
  email                                                                            String
  is_staff                                                                         Boolean
  is_active                                                                        Boolean
  date_joined                                                                      DateTime
  first_name                                                                       String
  auth_user_groups                                                                 auth_user_groups[]
  auth_user_user_permissions                                                       auth_user_user_permissions[]
  board_authorinvite_board_authorinvite_created_by_idToauth_user                   board_authorinvite[]          @relation("board_authorinvite_created_by_idToauth_user")
  board_authorinvite_board_authorinvite_claimed_by_idToauth_user                   board_authorinvite[]          @relation("board_authorinvite_claimed_by_idToauth_user")
  board_authorsubscription_board_authorsubscription_subscriber_idToauth_user       board_authorsubscription[]    @relation("board_authorsubscription_subscriber_idToauth_user")
  board_authorsubscription_board_authorsubscription_author_idToauth_user           board_authorsubscription[]    @relation("board_authorsubscription_author_idToauth_user")
  board_authorsubscriptionlog_board_authorsubscriptionlog_subscriber_idToauth_user board_authorsubscriptionlog[] @relation("board_authorsubscriptionlog_subscriber_idToauth_user")
  board_authorsubscriptionlog_board_authorsubscriptionlog_author_idToauth_user     board_authorsubscriptionlog[] @relation("board_authorsubscriptionlog_author_idToauth_user")
  board_comment                                                                    board_comment[]
  board_comment_likes                                                              board_comment_likes[]
  board_config                                                                     board_config?
  developerRequests                                                                DeveloperRequestLog[]
  developerTokens                                                                  DeveloperToken[]
  board_edithistory                                                                board_edithistory[]
  board_editrequest                                                                board_editrequest[]
  board_emailchange                                                                board_emailchange?
  formTemplates                                                                    FormTemplate[]
  uploadedImages                                                                   UploadedImage[]
  notifications                                                                    Notification[]
  board_pinnedpost                                                                 board_pinnedpost[]
  posts                                                                            Post[]
  board_post_likes                                                                 board_post_likes[]
  board_profile                                                                    board_profile?
  board_series                                                                     board_series[]
  banners                                                                          SiteBanner[]
  notices                                                                          SiteNotice[]
  board_socialauth                                                                 board_socialauth[]
  staticPages                                                                      StaticPage[]
  telegram                                                                         TelegramConnection?
  webhookChannels                                                                  WebhookChannel[]
  board_twofactorauth                                                              board_twofactorauth?
  board_userconfigmeta                                                             board_userconfigmeta[]
  board_userlinkmeta                                                               board_userlinkmeta[]
  usernameChanges                                                                  UsernameChange[]
  cleanupConfirmations                                                             CleanupConfirmation[]
  workLogs                                                                         WorkLog[]
  adminLogs                                                                        AdminLog[]
  sessions                                                                         Session[]

  @@map("auth_user")
}

model Session {
  tokenHash        String       @id @map("token_hash")
  userId           Int          @map("user_id")
  credentialTag    String       @map("credential_tag")
  expiresAt        BigInt       @map("expires_at")
  verifiedUntil    BigInt?      @map("verified_until")
  verifiedFactorId Int?         @map("verified_factor_id")
  requiresFactor   Int          @default(0) @map("requires_factor")
  user             User         @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  factorSetup      FactorSetup?

  @@index([userId], map: "blex_session_user_id_idx")
  @@index([expiresAt], map: "blex_session_expires_at_idx")
  @@map("blex_session")
}

model FactorSetup {
  sessionHash  String  @id @map("session_hash")
  secret       String
  recoveryHash String  @map("recovery_hash")
  expiresAt    BigInt  @map("expires_at")
  session      Session @relation(fields: [sessionHash], references: [tokenHash], onDelete: Cascade, onUpdate: Cascade)

  @@map("blex_factor_setup")
}

model NotificationDelivery {
  notificationId Int      @id
  attempts       Int      @default(0)
  availableAt    DateTime

  notification Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  @@index([availableAt])
}

model ScheduledPublication {
  postId    Int    @id @map("post_id")
  publishAt String @map("publish_at")
  post      Post   @relation(fields: [postId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([publishAt], map: "blex_scheduled_publication_publish_at_idx")
  @@map("blex_scheduled_publication")
}

model WebhookDelivery {
  postId      Int
  channelId   Int
  availableAt DateTime
  isDone      Boolean  @default(false)

  post    Post           @relation(fields: [postId], references: [id], onDelete: Cascade)
  channel WebhookChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@id([postId, channelId])
  @@index([isDone, availableAt])
}

model UsernameChange {
  id           Int      @id @default(autoincrement())
  username     String
  created_date DateTime
  userId       Int      @map("user_id")
  user         User     @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([username], map: "board_usern_usernam_873004_idx")
  @@index([userId], map: "board_usernamechangelog_user_id_42630b04")
  @@map("board_usernamechangelog")
}

model Post {
  id                   Int                    @id @default(autoincrement())
  title                String
  slug                 String                 @unique @map("url")
  image                String
  read_time            Int
  created_date         DateTime
  updated_date         DateTime
  authorId             Int                    @map("author_id")
  series_id            Int?
  metaDescription      String                 @map("meta_description")
  subtitle             String
  publishedDate        DateTime?              @map("published_date")
  image_hash           String
  deletedDate          DateTime?              @map("deleted_date")
  board_comment        board_comment[]
  board_edithistory    board_edithistory[]
  board_editrequest    board_editrequest[]
  board_pinnedpost     board_pinnedpost[]
  board_series         board_series?          @relation(fields: [series_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  author               User                   @relation(fields: [authorId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  board_post_likes     board_post_likes[]
  board_post_tags      board_post_tags[]
  config               PostConfig?
  board_postconfigmeta board_postconfigmeta[]
  content              PostContent?
  board_postsharelink  board_postsharelink[]
  scheduledPublication ScheduledPublication?
  webhookDeliveries    WebhookDelivery[]

  @@index([deletedDate], map: "board_post_deleted_date_e66a3ffc")
  @@index([authorId, publishedDate], map: "board_post_author__54dd01_idx")
  @@index([publishedDate], map: "board_post_publish_950f79_idx")
  @@index([slug], map: "board_post_url_7e049a_idx")
  @@index([created_date], map: "board_post_created_69fd60_idx")
  @@index([authorId, created_date], map: "board_post_author__effd83_idx")
  @@index([image_hash], map: "board_post_image_hash_4631962a")
  @@index([series_id], map: "board_post_series_id_05abc0fb")
  @@index([authorId], map: "board_post_author_id_1d40598b")
  @@map("board_post")
}

model PostContent {
  id     Int    @id @default(autoincrement())
  html   String @map("content_html")
  postId Int    @unique @map("post_id")
  post   Post   @relation(fields: [postId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("board_postcontent")
}

model PostConfig {
  id                   Int     @id @default(autoincrement())
  hide                 Boolean
  advertise            Boolean
  block_comment        Boolean
  postId               Int     @unique @map("post_id")
  cover_image_position String
  cover_image_ratio    String
  cover_layout         String
  post                 Post    @relation(fields: [postId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("board_postconfig")
}

model auth_group {
  id                     Int                      @id @default(autoincrement())
  name                   String                   @unique
  auth_group_permissions auth_group_permissions[]
  auth_user_groups       auth_user_groups[]
}

model auth_group_permissions {
  id              Int             @id @default(autoincrement())
  group_id        Int
  permission_id   Int
  auth_permission auth_permission @relation(fields: [permission_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  auth_group      auth_group      @relation(fields: [group_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([group_id, permission_id], map: "auth_group_permissions_group_id_permission_id_0cd325b0_uniq")
  @@index([permission_id], map: "auth_group_permissions_permission_id_84c5c92e")
  @@index([group_id], map: "auth_group_permissions_group_id_b120cbf9")
}

model auth_permission {
  id                         Int                          @id @default(autoincrement())
  content_type_id            Int
  codename                   String
  name                       String
  auth_group_permissions     auth_group_permissions[]
  django_content_type        django_content_type          @relation(fields: [content_type_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  auth_user_user_permissions auth_user_user_permissions[]

  @@unique([content_type_id, codename], map: "auth_permission_content_type_id_codename_01ab375a_uniq")
  @@index([content_type_id], map: "auth_permission_content_type_id_2f476e4b")
}

model auth_user_groups {
  id         Int        @id @default(autoincrement())
  user_id    Int
  group_id   Int
  auth_group auth_group @relation(fields: [group_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  auth_user  User       @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([user_id, group_id], map: "auth_user_groups_user_id_group_id_94350c0c_uniq")
  @@index([group_id], map: "auth_user_groups_group_id_97559544")
  @@index([user_id], map: "auth_user_groups_user_id_6a12ed8b")
}

model auth_user_user_permissions {
  id              Int             @id @default(autoincrement())
  user_id         Int
  permission_id   Int
  auth_permission auth_permission @relation(fields: [permission_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  auth_user       User            @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([user_id, permission_id], map: "auth_user_user_permissions_user_id_permission_id_14a6b632_uniq")
  @@index([permission_id], map: "auth_user_user_permissions_permission_id_1fbb5f2c")
  @@index([user_id], map: "auth_user_user_permissions_user_id_a95ead1b")
}

model board_authorinvite {
  id                                                    Int       @id @default(autoincrement())
  code                                                  String    @unique
  note                                                  String
  is_active                                             Boolean
  created_date                                          DateTime
  claimed_date                                          DateTime?
  claimed_by_id                                         Int?
  created_by_id                                         Int?
  auth_user_board_authorinvite_created_by_idToauth_user User?     @relation("board_authorinvite_created_by_idToauth_user", fields: [created_by_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  auth_user_board_authorinvite_claimed_by_idToauth_user User?     @relation("board_authorinvite_claimed_by_idToauth_user", fields: [claimed_by_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([claimed_by_id], map: "board_autho_claimed_0188bf_idx")
  @@index([code, is_active], map: "board_autho_code_e7ed63_idx")
  @@index([created_by_id], map: "board_authorinvite_created_by_id_0cd57a38")
  @@index([claimed_by_id], map: "board_authorinvite_claimed_by_id_7a8026eb")
}

model board_authorsubscription {
  id                                                          Int      @id @default(autoincrement())
  created_date                                                DateTime
  author_id                                                   Int
  subscriber_id                                               Int
  auth_user_board_authorsubscription_subscriber_idToauth_user User     @relation("board_authorsubscription_subscriber_idToauth_user", fields: [subscriber_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  auth_user_board_authorsubscription_author_idToauth_user     User     @relation("board_authorsubscription_author_idToauth_user", fields: [author_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([subscriber_id, author_id])
  @@index([author_id, created_date], map: "board_authorsub_author_idx")
  @@index([subscriber_id], map: "board_authorsubscription_subscriber_id_27e581a7")
  @@index([author_id], map: "board_authorsubscription_author_id_8b00b85d")
}

model board_authorsubscriptionlog {
  id                                                             Int      @id @default(autoincrement())
  action                                                         String
  created_date                                                   DateTime
  author_id                                                      Int
  subscriber_id                                                  Int
  auth_user_board_authorsubscriptionlog_subscriber_idToauth_user User     @relation("board_authorsubscriptionlog_subscriber_idToauth_user", fields: [subscriber_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  auth_user_board_authorsubscriptionlog_author_idToauth_user     User     @relation("board_authorsubscriptionlog_author_idToauth_user", fields: [author_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([author_id, created_date], map: "board_authorsublog_author_idx")
  @@index([subscriber_id], map: "board_authorsubscriptionlog_subscriber_id_55114cf2")
  @@index([author_id], map: "board_authorsubscriptionlog_author_id_9430554d")
}

model board_comment {
  id                  Int                   @id @default(autoincrement())
  text_md             String
  text_html           String
  edited              Boolean
  heart               Boolean
  created_date        DateTime
  author_id           Int?
  post_id             Int
  parent_id           Int?
  board_comment       board_comment?        @relation("board_commentToboard_comment", fields: [parent_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  other_board_comment board_comment[]       @relation("board_commentToboard_comment")
  board_post          Post                  @relation(fields: [post_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  auth_user           User?                 @relation(fields: [author_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  board_comment_likes board_comment_likes[]

  @@index([author_id, created_date], map: "board_comme_author__e4042f_idx")
  @@index([post_id, parent_id, created_date], map: "board_comme_post_id_260f64_idx")
  @@index([parent_id], map: "board_comment_parent_id_511c6974")
  @@index([post_id], map: "board_comment_post_id_0a1699af")
  @@index([author_id], map: "board_comment_author_id_08705ab7")
}

model board_comment_likes {
  id            Int           @id @default(autoincrement())
  comment_id    Int
  user_id       Int
  auth_user     User          @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  board_comment board_comment @relation(fields: [comment_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([comment_id, user_id], map: "board_comment_likes_comment_id_user_id_c6d811be_uniq")
  @@index([user_id], map: "board_comment_likes_user_id_4c484ae1")
  @@index([comment_id], map: "board_comment_likes_comment_id_3ab8c714")
}

model board_config {
  id        Int     @id @default(autoincrement())
  user_id   Int     @unique
  language  String?
  time_zone String
  auth_user User    @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model DeveloperRequestLog {
  id         Int      @id @default(autoincrement())
  userId     Int
  tokenId    Int?
  method     String
  path       String
  statusCode Int
  ipAddress  String?
  userAgent  String   @default("")
  createdAt  DateTime @default(now())

  user  User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  token DeveloperToken? @relation(fields: [tokenId], references: [id], onDelete: SetNull)

  @@index([tokenId, createdAt])
  @@index([userId, createdAt])
}

model DeveloperToken {
  id          Int       @id @default(autoincrement())
  userId      Int
  name        String
  tokenPrefix String    @unique
  tokenHash   String    @unique
  scopes      Json
  expiresAt   DateTime?
  revokedAt   DateTime?
  lastUsedAt  DateTime?
  lastUsedIp  String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user     User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  requests DeveloperRequestLog[]

  @@index([userId, revokedAt])
}

model board_edithistory {
  id                      Int                 @id @default(autoincrement())
  content                 String
  created_date            DateTime
  post_id                 Int
  actor_id                Int?
  change_type             String
  description             String
  source_updated_date     DateTime?
  subtitle                String
  tags                    String
  title                   String
  restored_from_id        Int?
  content_excerpt         String?
  board_edithistory       board_edithistory?  @relation("board_edithistoryToboard_edithistory", fields: [restored_from_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  other_board_edithistory board_edithistory[] @relation("board_edithistoryToboard_edithistory")
  auth_user               User?               @relation(fields: [actor_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  board_post              Post                @relation(fields: [post_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([post_id, created_date], map: "board_edith_post_id_50a332_idx")
  @@index([restored_from_id], map: "board_edithistory_restored_from_id_fdd2f281")
  @@index([actor_id], map: "board_edithistory_actor_id_13dc7485")
  @@index([post_id], map: "board_edithistory_post_id_7ac2da0d")
}

model board_editrequest {
  id           Int      @id @default(autoincrement())
  title        String
  content      String
  is_merged    Boolean
  created_date DateTime
  updated_date DateTime
  user_id      Int
  post_id      Int
  board_post   Post     @relation(fields: [post_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  auth_user    User     @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([post_id], map: "board_editrequest_post_id_77346467")
  @@index([user_id], map: "board_editrequest_user_id_0deec073")
}

model board_emailchange {
  id           Int      @id @default(autoincrement())
  email        String
  auth_token   String
  created_date DateTime
  user_id      Int      @unique
  auth_user    User     @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model board_loginattempt {
  key    String @id
  window BigInt
  count  Int

  @@index([window], map: "board_loginattempt_window_a08cc5bd")
}

model Notification {
  id            Int      @id @default(autoincrement())
  userId        Int
  key           String   @unique
  url           String   @default("")
  content       String   @default("")
  messageKey    String   @default("")
  messageParams Json
  isRead        Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @default(now())

  user     User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  delivery NotificationDelivery?

  @@index([userId])
}

model board_pinnedpost {
  id           Int      @id @default(autoincrement())
  order        Int
  created_date DateTime
  post_id      Int
  user_id      Int
  auth_user    User     @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  board_post   Post     @relation(fields: [post_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([user_id, post_id])
  @@index([user_id], map: "board_pinnedpost_user_id_162d6fde")
  @@index([post_id], map: "board_pinnedpost_post_id_5c30f851")
}

model board_post_likes {
  id           Int      @id @default(autoincrement())
  created_date DateTime
  post_id      Int
  user_id      Int
  auth_user    User     @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  board_post   Post     @relation(fields: [post_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([post_id, user_id])
  @@index([user_id, created_date], map: "board_post__user_id_44c70b_idx")
  @@index([post_id, user_id], map: "board_post__post_id_ce5821_idx")
  @@index([user_id], map: "board_post_likes_user_id_ec7f0988")
  @@index([post_id], map: "board_post_likes_post_id_d498fb9b")
}

model board_post_share_link_daily_counts {
  id                  Int                 @id @default(autoincrement())
  day                 DateTime
  clicks              BigInt
  link_id             Int
  board_postsharelink board_postsharelink @relation(fields: [link_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([link_id, day])
  @@index([link_id], map: "board_post_share_link_daily_counts_link_id_2f58d048")
}

model board_post_tags {
  id         Int       @id @default(autoincrement())
  post_id    Int
  tag_id     Int
  board_tag  board_tag @relation(fields: [tag_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  board_post Post      @relation(fields: [post_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([post_id, tag_id], map: "board_post_tags_post_id_tag_id_b584ff2b_uniq")
  @@index([tag_id], map: "board_post_tags_tag_id_7972a030")
  @@index([post_id], map: "board_post_tags_post_id_b46f227b")
}

model board_postconfigmeta {
  id           Int      @id @default(autoincrement())
  name         String
  value        String
  created_date DateTime
  updated_date DateTime
  post_id      Int
  board_post   Post     @relation(fields: [post_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([post_id], map: "board_postconfigmeta_post_id_6e39a197")
}

model board_postsharelink {
  id                                 Int                                  @id @default(autoincrement())
  token                              String                               @unique
  label                              String
  is_paused                          Boolean
  created_date                       DateTime
  post_id                            Int
  board_post_share_link_daily_counts board_post_share_link_daily_counts[]
  board_post                         Post                                 @relation(fields: [post_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([post_id], map: "board_postsharelink_post_id_4819c9d6")
}

model board_profile {
  id                  Int    @id @default(autoincrement())
  bio                 String
  cover               String
  avatar              String
  homepage            String
  about_md            String
  about_html          String
  user_id             Int    @unique
  analytics_share_url String
  role                String
  auth_user           User   @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model board_series {
  id                     Int                      @id @default(autoincrement())
  order                  Int
  text_md                String
