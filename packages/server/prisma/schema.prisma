}

model WorkLog {
  id        Int      @id @default(autoincrement())
  ownerId   Int
  title     String
  createdAt DateTime @default(now())

  owner   User           @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  entries WorkLogEntry[]
  shares  WorkLogShare[]

  @@index([ownerId])
}

model WorkLogEntry {
  id         Int      @id @default(autoincrement())
  logId      Int
  title      String   @default("")
  text       String   @default("")
  mediaType  String   @default("")
  attachment String   @default("")
  createdAt  DateTime @default(now())

  log    WorkLog        @relation(fields: [logId], references: [id], onDelete: Cascade)
  shares WorkLogShare[]

  @@index([logId, createdAt(sort: Desc), id(sort: Desc)])
