{
    "name": "@blex/remotes",
    "version": "1.0.0",
    "description": "React islands for BLEX Django project",
    "type": "module",
    "scripts": {
        "dev": "node scripts/dev.mjs",
        "watch:assets": "node scripts/watch-assets.js",
        "build": "node scripts/watch-assets.js --once && vite build",
        "check:entry-budgets": "node scripts/check-entry-budgets.mjs",
        "e2e:smoke": "playwright test --config playwright.config.ts",
        "i18n:extract": "lingui extract --clean",
        "i18n:compile": "lingui compile --strict",
        "i18n:check": "node scripts/check-i18n.mjs",
        "test": "node --test test/*.test.mjs",
        "lint": "eslint src test",
        "type-check": "tsc --noEmit"
    },
    "dependencies": {
        "@baejino/handy": "^0.2.3",
        "@baejino/style": "^0.2.2",
        "@blex/editor": "workspace:^",
        "@blex/ui": "workspace:^",
        "@dnd-kit/core": "^6.3.1",
        "@dnd-kit/modifiers": "^9.0.0",
        "@dnd-kit/sortable": "^10.0.0",
        "@dnd-kit/utilities": "^3.2.2",
        "@fortawesome/fontawesome-free": "^7.3.0",
        "@hookform/resolvers": "^5.4.0",
        "@lingui/core": "^6.6.0",
        "@lingui/react": "^6.6.0",
        "@tanstack/react-query": "^5.101.2",
        "@tanstack/react-query-persist-client": "^5.101.2",
        "@tanstack/react-router": "^1.170.17",
        "alpinejs": "^3.15.12",
        "axios": "^1.18.1",
        "driver.js": "^1.6.0",
        "react": "^19.2.7",
        "react-day-picker": "^10.0.1",
        "react-dom": "^19.2.7",
        "react-easy-crop": "^6.2.2",
        "react-hook-form": "^7.81.0",
        "styled-jsx": "^5.1.7",
        "zod": "^4.4.3"
    },
    "devDependencies": {
        "@babel/core": "7.29.6",
        "@baejino/eslint-config": "^0.1.1",
        "@baejino/eslint-config-react": "^0.1.1",
        "@lingui/babel-plugin-lingui-macro": "^6.6.0",
        "@lingui/cli": "^6.6.0",
        "@lingui/vite-plugin": "^6.6.0",
        "@playwright/test": "^1.61.1",
        "@rolldown/plugin-babel": "^0.2.3",
        "@tailwindcss/postcss": "^4.3.2",
        "@tailwindcss/vite": "^4.3.2",
        "@types/alpinejs": "^3.13.11",
        "@types/babel__core": "^7.20.5",
        "@types/react": "^19.2.17",
        "@types/react-dom": "^19.2.3",
        "@vitejs/plugin-react": "^6.0.3",
        "autoprefixer": "^10.5.2",
        "babel-plugin-react-compiler": "^1.0.0",
        "chokidar": "^5.0.0",
        "eslint": "^9.39.5",
        "eslint-plugin-react-compiler": "19.1.0-rc.2",
        "glob": "^13.0.6",
        "postcss": "^8.5.24",
        "react-grab": "^0.1.48",
        "rollup-plugin-visualizer": "^7.0.1",
        "sass": "^1.101.0",
        "tailwindcss": "^4.3.2",
        "tailwindcss-animate": "^1.0.7",
        "typescript": "^5.9.3",
        "vite": "^8.1.4",
        "yaml": "^2.9.0"
