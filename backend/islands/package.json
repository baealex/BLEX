{
    "name": "blex-islands-monorepo",
    "private": true,
    "scripts": {
        "dev": "turbo run build --filter=@blex/ui --filter=@blex/editor && turbo run dev --parallel",
        "build": "turbo run build",
        "check:entry-budgets": "pnpm --filter @blex/remotes run check:entry-budgets",
        "e2e:smoke": "pnpm --filter @blex/remotes run e2e:smoke",
        "i18n:check": "pnpm --filter @blex/remotes run i18n:check",
        "test": "pnpm --filter @blex/editor --filter @blex/remotes run test",
        "lint": "turbo run lint",
        "type-check": "turbo run type-check"
    },
    "devDependencies": {
        "@baejino/eslint-config": "^0.1.1",
        "@baejino/eslint-config-react": "^0.1.1",
        "eslint": "^9.39.5",
        "glob": "^13.0.6",
        "tsup": "^8.5.1",
        "turbo": "^2.10.4",
        "typescript": "^5.9.3",
        "yaml": "^2.9.0"
    },
    "engines": {
        "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
    },
    "packageManager": "pnpm@11.17.0"
}
